{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "../build",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts"
  ]
}
